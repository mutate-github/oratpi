#!/bin/bash
set -f

base64_encode() {
    if [ $# -gt 0 ]; then
        printf '%s' "$1" | perl -MMIME::Base64 -0777 -ne 'print encode_base64($_, "")'
    else
        perl -MMIME::Base64 -0777 -ne 'print encode_base64($_, "")'
    fi
    echo
}

base64_decode() {
    if [ $# -gt 0 ]; then
        printf '%s' "$1" | perl -MMIME::Base64 -0777 -ne 'print decode_base64($_)'
    else
        perl -MMIME::Base64 -0777 -ne 'print decode_base64($_)'
    fi
}

